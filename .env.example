# Phase 1 local configuration. Do not put secrets in this file.
SHRAVYA_ENVIRONMENT=development
SHRAVYA_PROVIDER_MODE=deterministic_demo
SHRAVYA_DATABASE_URL=sqlite:///./shravya.db
SHRAVYA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Local, CPU-only faster-whisper mode. The first real request may download
# model weights; automated tests inject fakes and never download a model.
# SHRAVYA_PROVIDER_MODE=local_faster_whisper
SHRAVYA_WHISPER_MODEL=small
SHRAVYA_WHISPER_DEVICE=cpu
SHRAVYA_WHISPER_COMPUTE_TYPE=int8
SHRAVYA_WHISPER_LANGUAGE=ml
SHRAVYA_WHISPER_MULTILINGUAL=true
SHRAVYA_WHISPER_BEAM_SIZE=5
SHRAVYA_WHISPER_VAD=true
SHRAVYA_WHISPER_WORD_TIMESTAMPS=true
